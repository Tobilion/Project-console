node_modules/
build/
dist/
# The desktop shell's build-resources icon must ship (CI mac/linux packaging reads it) —
# the generic `build/` pattern above would otherwise ignore it.
!desktop/build/
!desktop/build/icon.png
coverage/
.DS_Store
Thumbs.db
*.log
npm-debug.log*
.env*
!.env.example
*.tsbuildinfo
.vite/

# Downloaded embedding model cache (~23MB, re-fetched on first run)
.cache/

# Runtime-generated usage data (near-misses, telemetry, conversation index) —
# regenerated per install, not meant to be version-controlled
data/near-misses/
data/telemetry/
data/conversations/
# Last-known dev-server URLs (runtime mirror of state.lastDevUrls, see devUrlStore.js)
data/dev-urls.json
# Phase 8: runtime tuning-constant overrides (see tuningStore.js)
data/tuning.json
# Phase 1: persisted scheduled triggers + unattended-fire log (see schedules/scheduleStore.js)
data/schedules.json
data/schedule-log.md
# Phase 2: notification rules + webhook URLs (bearer secrets — never git-tracked, see notify/notifyStore.js)
data/notifications.json
# Phase 8: OS clipboard history when clipboardPersist is on (privacy — never git-tracked)
data/clipboard-history.json
# Rolling match-quality telemetry (one line per trigger-mode message — see matchStats.js)
data/match-stats.jsonl

# Local Project Console chat memory (not for git)
.console/

# Daemon runtime logs and PID files
logs/
*.pid

# Stray node-nlp save artifact — see nlpEngine.js's train()/retrainFromLearned() comments (2026-07-30):
# this used to get rewritten at the repo root on every project scan and was never actually read
# back by anything, causing an unwanted Vite dev-server reload each time. The save call is now
# removed, but this stays ignored as a guard in case a stale copy exists locally or reappears.
model.nlp

# AI-session prompt/spec files — paste-in context for sessions, not app docs. Kept locally
# for reference, never committed (untracked 2026-08-03).
console-intent-expansion-prompt.md
console-chitchat-ai-upgrade-prompt.md
AI-FIX-PLAN.md
AUDIT_REMEDIATION_PROMPT.md
BUG_FIX_PROMPT.md
CODE-REVIEW.md
LOCAL_ROUTER_UPGRADE_PROMPT.md
console-theme-redesign-prompt.md
PROJECT-CONSOLE-INFRA-PROMPT.md
AUDIT-PROMPT.md
# Multi-phase execution plan (phases 0-18) — the working spec for roadmap sessions, never
# committed; delete once all phases are done (user decision 2026-08-11).
UPGRADE-ROADMAP.md


# Phase 7: per-project auto-start config + boot-run log (see autoStartProjects.js)
data/auto-start.json
data/auto-start-log.md
# Phase 7: intent-collision baseline for the boot-time sweep (see collisions.js)
data/collisions.json

# Runtime stores documented as gitignored (CLAUDE.md/features.md) that lacked an entry — a
# backup zip, snippet, learned phrase, registry URL or workspace file would otherwise be an
# un-ignored, easy-to-commit artifact. data/registry-config.json + metadata.json were tracked
# before this entry and were `git rm --cached`ed so the ignore is authoritative.
data/editors.json
data/snippets.json
data/learned-intents.json
data/registry-config.json
data/backups/
data/workspace-exports/
data/distillations/
data/general-workspace/
metadata.json

# electron-builder staging dir (desktop builds)
desktop/stage/

# Unattended-run execution plan (2026-08-26) — durable session record, never committed
/.plans/
