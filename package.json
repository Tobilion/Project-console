{
  "name": "local-project-console",
  "description": "A local, offline command dispatcher and AI assistant for managing multiple software projects from a single web interface.",
  "author": "Tobi",
  "license": "MIT",
  "private": false,
  "version": "1.0.9",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "local-project-console": "bin/cli.js"
  },
  "type": "module",
  "files": [
    "bin/",
    "dist/",
    "server/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx server/index.js",
    "launcher": "node bin/cli.js launcher",
    "start": "node dist/server.js",
    "build": "vite build && esbuild server/index.js --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 server/test/matcher.test.js server/test/fuzzSafety.test.js server/test/safetyExtras.test.js scripts/checkWsMessageCases.ts",
    "test:coverage": "node --import tsx --test --test-concurrency=1 --experimental-test-coverage server/test/matcher.test.js server/test/fuzzSafety.test.js server/test/safetyExtras.test.js scripts/checkWsMessageCases.ts",
    "check-intents": "node --import tsx server/scripts/checkIntentDuplicates.js",
    "check-matcher": "node --import tsx server/scripts/checkMatcherCoverage.js",
    "check-indexer": "node --import tsx server/scripts/checkIndexerCoverage.js",
    "check-tools": "node --import tsx server/scripts/checkToolsCoverage.js",
    "check-handlers": "node --import tsx server/scripts/checkHandlerCoverage.js",
    "check-ws-cases": "node --import tsx --test scripts/checkWsMessageCases.ts",
    "check-docs": "node --import tsx server/scripts/checkDocsSync.js",
    "check-encoding": "node server/scripts/checkEncoding.js",
    "daemon": "node scripts/daemon.mjs",
    "daemon:start": "node scripts/daemon.mjs start",
    "daemon:stop": "node scripts/daemon.mjs stop",
    "daemon:status": "node scripts/daemon.mjs status",
    "doctor": "node --import tsx server/doctor.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@nlpjs/builtin-microsoft": "^5.0.0-alpha.5",
    "@nlpjs/core-loader": "^5.0.0-alpha.5",
    "@nlpjs/lang-en": "^5.0.0-alpha.5",
    "@nlpjs/nlp": "^5.0.0-alpha.5",
    "archiver": "^7.0.1",
    "async-mutex": "^0.5.0",
    "boxen": "^8.0.1",
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "chrono-node": "^2.10.1",
    "compression": "^1.8.1",
    "cowsay": "^1.6.0",
    "express": "^4.21.2",
    "figlet": "^1.11.4",
    "fuse.js": "^7.5.0",
    "mammoth": "^1.12.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "typescript": "~5.8.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.0",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jspdf": "^4.2.1",
    "lint-staged": "^17.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pino-pretty": "^13.1.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "vite": "^6.2.3"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.2",
    "re2": "^1.24.1"
  },
  "allowScripts": {
    "re2@1.26.1": true,
    "re2@1.24.1": true,
    "sharp@0.32.6": true,
    "sharp@0.35.3": true,
    "protobufjs@6.11.6": true,
    "protobufjs@7.6.5": true
  },
  "overrides": {
    "protobufjs": "^7.6.5",
    "sharp": "^0.35.3"
  }
}
