{
  "name": "local-project-console",
  "description": "A local, offline command dispatcher and AI assistant for managing multiple software projects from a single web interface.",
  "private": false,
  "version": "1.0.1",
  "bin": {
    "local-project-console": "bin/cli.js"
  },
  "type": "module",
  "files": [
    "bin/",
    "dist/",
    "server/",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx server/index.js",
    "start": "node dist/server.js",
    "build": "vite build && esbuild server/index.js --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "lint": "tsc --noEmit",
    "check-intents": "node server/scripts/checkIntentDuplicates.js",
    "check-matcher": "node server/scripts/checkMatcherCoverage.js",
    "check-indexer": "node server/scripts/checkIndexerCoverage.js",
    "check-tools": "node server/scripts/checkToolsCoverage.js",
    "check-handlers": "node server/scripts/checkHandlerCoverage.js",
    "check-ws-cases": "tsx scripts/checkWsMessageCases.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@xenova/transformers": "^2.17.2",
    "async-mutex": "^0.5.0",
    "boxen": "^8.0.1",
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "figlet": "^1.11.4",
    "fuse.js": "^7.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "natural": "^8.1.1",
    "node-nlp": "^5.0.0-alpha.5",
    "re2": "^1.24.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "vite": "^6.2.3"
  },
  "allowScripts": {
    "re2@1.24.1": true,
    "sharp@0.32.6": true,
    "sharp@0.35.3": true,
    "protobufjs@6.11.6": true
  }
}
