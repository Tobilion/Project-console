{
  "name": "local-project-console-desktop",
  "version": "1.0.2",
  "description": "Project Console desktop shell — Electron wrapper around the local Express+WS server",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "stage": "node scripts/stage-server.mjs",
    "dist": "npm run stage && electron-builder --win nsis",
    "dist:publish": "npm run stage && electron-builder --win nsis --publish always",
    "dist:mac": "npm run stage && electron-builder --mac dmg",
    "dist:linux": "npm run stage && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.localprojectconsole.app",
    "productName": "Project Console",
    "files": [
      "main.cjs",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "stage",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Project Console",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "license": "../LICENSE",
      "artifactName": "Project Console Setup ${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "include": "scripts/nsis-cli-shortcut.nsh"
    },
    "afterPack": "scripts/after-pack.cjs",
    "publish": {
      "provider": "github",
      "owner": "Tobilion",
      "repo": "Project-console"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "~26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
